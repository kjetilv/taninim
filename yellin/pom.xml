<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.github.kjetilv.taninim</groupId>
    <artifactId>taninim-parent</artifactId>
    <version>0.1.1-SNAPSHOT</version>
  </parent>

  <artifactId>yellin</artifactId>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>fb</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>taninim</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.kjetilv.uplift</groupId>
      <artifactId>uplift-hash</artifactId>
      <version>${uplift.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.kjetilv.uplift</groupId>
      <artifactId>uplift-kernel</artifactId>
      <version>${uplift.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.kjetilv.uplift</groupId>
      <artifactId>uplift-flogs</artifactId>
      <version>${uplift.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.kjetilv.uplift</groupId>
      <artifactId>uplift-s3</artifactId>
      <version>${uplift.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.kjetilv.uplift</groupId>
      <artifactId>uplift-json</artifactId>
      <version>${uplift.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.kjetilv.uplift</groupId>
      <artifactId>uplift-json-gen</artifactId>
      <version>${uplift.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.kjetilv.uplift</groupId>
      <artifactId>uplift-json-anno</artifactId>
      <version>${uplift.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.kjetilv.uplift</groupId>
      <artifactId>uplift-json-mame</artifactId>
      <version>${uplift.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.kjetilv.uplift</groupId>
      <artifactId>uplift-lambda</artifactId>
      <version>${uplift.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.kjetilv.uplift</groupId>
      <artifactId>uplift-util</artifactId>
      <version>${uplift.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>com.github.kjetilv.uplift</groupId>
              <artifactId>uplift-json-gen</artifactId>
              <version>${uplift.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.github.kjetilv.uplift</groupId>
        <artifactId>uplift-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>native-lambda</id>
            <goals>
              <goal>native-lambda</goal>
            </goals>
            <configuration>
              <main>yellin</main>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
