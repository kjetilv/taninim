<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.kjetilv.taninim</groupId>
        <artifactId>taninim-parent</artifactId>
        <version>0.1.1-SNAPSHOT</version>
    </parent>

    <artifactId>fb</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.github.kjetilv.uplift</groupId>
            <artifactId>uplift-flogs</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.kjetilv.uplift</groupId>
            <artifactId>uplift-hash</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.kjetilv.uplift</groupId>
            <artifactId>uplift-json</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.kjetilv.uplift</groupId>
            <artifactId>uplift-json-anno</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.kjetilv.uplift</groupId>
            <artifactId>uplift-json-gen</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.kjetilv.uplift</groupId>
            <artifactId>uplift-util</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.kjetilv.uplift</groupId>
            <artifactId>uplift-kernel</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.github.kjetilv.uplift</groupId>
                            <artifactId>uplift-json-gen</artifactId>
                            <version>${uplift.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
